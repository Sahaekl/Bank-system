using System;

namespace oop
{
    class BankAccount
    {
        public string AccountNumber { get; set; }
        public string OwnerName { get; set; }
        public decimal Balance { get; private set; }
        public DateTime CreatedDate { get; set; }

        // Constructor
        public BankAccount(
            string accountNumber,
            string ownerName,
            decimal balance,
            DateTime createdDate)
        {
            // Validation
            if (string.IsNullOrWhiteSpace(accountNumber))
            {
                throw new ArgumentException("Account number cannot be empty.");
            }

            if (string.IsNullOrWhiteSpace(ownerName))
            {
                throw new ArgumentException("Owner name cannot be empty.");
            }

            if (balance < 0)
            {
                throw new ArgumentException("Balance cannot be negative.");
            }

            // Assignment after validation
            AccountNumber = accountNumber;
            OwnerName = ownerName;
            Balance = balance;
            CreatedDate = createdDate;
        }

        public virtual void DepositMoney(decimal amount)
        {
            if (amount <= 0)
            {
                Console.WriteLine("Amount must be greater than zero.");
            }
            else
            {
                Balance += amount;
            }
        }

        public virtual void WithdrawMoney(decimal amount)
        {
            if (amount <= 0)
            {
                Console.WriteLine("Amount must be greater than zero.");
            }
            else if (amount > Balance)
            {
                Console.WriteLine("Insufficient balance.");
            }
            else
            {
                Balance -= amount;
            }
        }

        protected void AddToBalance(decimal amount)
        {
            Balance += amount;
        }

        protected void SubtractFromBalance(decimal amount)
        {
            Balance -= amount;
        }

        public void DisplayDetails()
        {
            Console.WriteLine($"Account Number: {AccountNumber}");
            Console.WriteLine($"Owner Name: {OwnerName}");
            Console.WriteLine($"Balance: {Balance}");
            Console.WriteLine($"Created Date: {CreatedDate}");
        }
    }


    class SavingsAccount : BankAccount
    {
        public SavingsAccount(
            string accountNumber,
            string ownerName,
            decimal balance,
            DateTime createdDate)
            : base(accountNumber, ownerName, balance, createdDate)
        {
        }

        public void AddMonthly()
        {
            AddToBalance(Balance * 0.05m);
        }
    }


    class CurrentAccount : BankAccount
    {
        // Withdrawal fee
        private decimal withdrawalFee = 10m;

        public CurrentAccount(
            string accountNumber,
            string ownerName,
            decimal balance,
            DateTime createdDate)
            : base(accountNumber, ownerName, balance, createdDate)
        {
        }

        public override void WithdrawMoney(decimal amount)
        {
            if (amount <= 0)
            {
                Console.WriteLine("Amount must be greater than zero.");
            }
            else if (amount + withdrawalFee > Balance)
            {
                Console.WriteLine("Insufficient balance.");
            }
            else
            {
                SubtractFromBalance(amount + withdrawalFee);
            }
        }
    }


    internal class Program
    {
        static void Main(string[] args)
        {
            // Savings Account
            SavingsAccount s1 = new SavingsAccount(
                "1AC",
                "Roaa",
                1223m,
                DateTime.Now
            );

            s1.DepositMoney(1000);
            s1.WithdrawMoney(20);
            s1.AddMonthly();
            s1.DisplayDetails();


            Console.WriteLine();


            // Current Account
            CurrentAccount c1 = new CurrentAccount(
                "1AC2",
                "Ahmed",
                1000m,
                DateTime.Now
            );

            c1.DepositMoney(500);
            c1.WithdrawMoney(200);
            c1.DisplayDetails();
        }
    }
}
